<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      MainActivity handles edge-to-edge itself via enableEdgeToEdge() + Compose insets, so the
      legacy bar-coloring attributes AppCompat's base theme still carries (which Android 15
      deprecates and Play Console's pre-launch report flags: setStatusBarColor/
      setNavigationBarColor/LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES) are neutralized here rather
      than left to inherit non-transparent defaults.

      windowLayoutInDisplayCutoutMode="always" (LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS, API 30+) is
      NOT set here: `tools:targetApi` only suppresses the lint warning, it does not gate the XML
      attribute at runtime, and applying it below API 30 crashes PhoneWindow.generateLayout with
      "Unknown windowLayoutInDisplayCutoutMode: 3" on first decor creation (reproduced on API 28).
      It's set only in values-v30/themes.xml instead; androidx's enableEdgeToEdge() already applies
      the appropriate SHORT_EDGES/DEFAULT mode for pre-30 devices at runtime.
    -->
    <style name="Theme.VoiceBudget" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
